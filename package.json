{
  "name": "hissab",
  "version": "1.0.0",
  "description": "Hissab Monorepo",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "update": "pnpm update -i --latest",
    "pretty": "prettier --write .",
    "pretty-check": "prettier --check .",
    "lint-check": "eslint --quiet .",
    "lint": "eslint --quiet . --fix",
    "ready": "pnpm run pretty && pnpm run lint && pnpm run test && pnpm run build",
    "check": "pnpm run pretty-check && pnpm run lint-check && pnpm run test",
    "gh:secrets:dev": "gh secret set --env dev -f .env.dev",
    "gh:secrets:prod": "gh secret set --env prod -f .env.prod",
    "clear:cache": "pnpm store prune"
  },
  "keywords": [],
  "author": "Mufaddal Makati",
  "license": "ISC",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.27.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "wrangler": "^4.17.0"
  },
  "dependencies": {
    "zod": "^3.25.30",
    "@heroui/react": "^2.7.8"
  }
}
