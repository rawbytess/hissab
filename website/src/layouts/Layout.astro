---
import "../css/index.css";
import "../css/home.css";
import "../css/custom.css";
import "../css/tailwind.css";
import Header from "../components/Header.tsx";
import Footer from "../components/Footer.tsx";
import {HeroUIProvider } from "@heroui/react";


---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/img/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta
			name="description"
			content="AI powered natural language calculator that answers accurately. Just type and calculate anything with ease.
      Perform basic to advanced calculations in multiple languages, do unit conversions, percentage operations, date and time calculations,
      access realtime finance data and more."
		/>
		<title>Hissab - Calculator with Superpowers</title>
		<script defer src="https://analytics.rawbytes.com/script.js" data-website-id="19ee36c5-98a3-48d8-bf85-8ebfb5f6c17d"></script>
	</head>
	<body class="dark">
    <HeroUIProvider client:load>
      <div class="grid grid-cols-1 grid-rows-[auto_1fr_auto] min-h-screen">
        <Header client:load />
        <slot />
        <Footer client:load />
      </div>
    </HeroUIProvider>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
