---
import "../css/index.css";
import "../css/home.css";
import "../css/custom.css";
import "../css/tailwind.css";
import Header from "../components/Header.tsx";
import Footer from "../components/Footer.tsx";
import {HeroUIProvider } from "@heroui/react";
import { PostHogProvider } from 'posthog-js/react'

const options = {
  api_host: import.meta.env.PUBLIC_POSTHOG_HOST ?? "",
}
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/img/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta
			name="description"
			content="A simple and intuitive calculator, unit-convertor and productivity application. Just type and calculate anything."
		/>
		<title>Hissab - Calculator with Superpowers</title>

	</head>
	<body class="dark">
  <PostHogProvider apiKey={import.meta.env.PUBLIC_POSTHOG_KEY ?? ""} options={options}>
    <HeroUIProvider client:load>
      <div class="grid grid-cols-1 grid-rows-[auto_1fr_auto] min-h-screen">
        <Header client:load />
        <slot />
        <Footer client:load />
      </div>
    </HeroUIProvider>
  </PostHogProvider>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
