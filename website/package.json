{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "wrangler:dev": "wrangler pages dev ./dist --d1=dev-db",
    "auth:schema:generate": "npx @better-auth/cli generate --y --output=./src/db/auth.ts",
    "drizzle:schema:generate": "pnpm drizzle-kit generate",
    "schema:generate": "pnpm auth:schema:generate && pnpm drizzle:schema:generate",
    "schema:migrate": "pnpm drizzle-kit migrate",
    "db:create": "wrangler wrangler d1 migrations create D1",
    "db:list": "wrangler wrangler d1 migrations list D1",
    "db:migrate": "wrangler wrangler d1 migrations migrate --local",
    "db:migrate:prod": "wrangler wrangler d1 migrations migrate --remote",
    "drizzle:studio:local": "drizzle-kit studio --config=drizzle.local.config.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^11.2.0",
    "@astrojs/react": "^3.6.3",
    "@astrojs/starlight": "^0.29.2",
    "@astrojs/tailwind": "^5.1.2",
    "astro": "^4.16.16",
    "better-auth": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.2",
    "editor": "workspace:*",
    "engine": "workspace:*",
    "hono": "^4.6.12",
    "lottie-react": "^2.4.0",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hover-video-player": "^10.0.2",
    "react-super-responsive-table": "^6.0.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@astrojs/node": "^8.3.4",
    "@better-auth/cli": "^1.0.21",
    "@cloudflare/workers-types": "^4.20241205.0",
    "better-sqlite3": "^11.7.0",
    "drizzle-kit": "^0.30.1"
  }
}
