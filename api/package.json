{
  "name": "hissab-api",
  "version": "0.1.0",
  "description": "Cloudflare Workers TypeScript for hissab apis",
  "main": "src/index.ts",
  "author": {
    "name": "Mufaddal Makati",
    "email": "mufaddal@rawbytes.com"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "publish": "wrangler deploy",
    "d1:migrate:logs:local": "wrangler d1 migrations apply dev-logs --local",
    "d1:migrate:user:local": "wrangler d1 migrations apply hsb-dev-user --local",
    "d1:migrate:logs:dev": "wrangler d1 migrations apply dev-logs --remote --env dev",
    "d1:migrate:logs:prod": "wrangler d1 migrations apply prod-logs --remote --env prod",
    "d1:migrate:user:dev": "wrangler d1 migrations apply hsb-dev-user --remote --env dev",
    "d1:migrate:user:prod": "wrangler d1 migrations apply hsb-prod-user --remote --env prod",
    "d1:migrate:all:dev": "pnpm d1:migrate:logs:dev && pnpm d1:migrate:user:dev",
    "d1:migrate:all:prod": "pnpm d1:migrate:apply:prod && pnpm d1:migrate:apply:user:prod",
    "d1:migrate:local": "pnpm d1:migrate:logs:local && pnpm d1:migrate:user:local",
    "source:env:dev": "set -o allexport; source .dev.vars; set +o allexport"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250525.0",
    "@google/gemini-cli": "^0.1.12",
    "dotenv": "^16.5.0",
    "wrangler": "^4.17.0"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.835.0",
    "@google/genai": "^1.1.0",
    "@hono-rate-limiter/cloudflare": "^0.2.2",
    "@hono/zod-validator": "^0.6.0",
    "@polar-sh/hono": "^0.3.1",
    "@polar-sh/sdk": "^0.34.2",
    "@hono/mcp": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.15.1",
    "date-fns": "^4.1.0",
    "engine": "workspace:*",
    "hono": "^4.7.10",
    "nanoid": "^5.1.5",
    "openai": "^5.1.0",
    "standardwebhooks": "^1.0.0"
  }
}
