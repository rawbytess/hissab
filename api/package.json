{
  "name": "hissab-api",
  "version": "0.1.0",
  "description": "Cloudflare Workers TypeScript for hissab apis",
  "main": "src/index.ts",
  "author": {
    "name": "Mufaddal Makati",
    "email": "mufaddal@rawbytes.com"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "publish": "wrangler deploy",
    "pretty": "npx prettier --write .",
    "pretty-check": "npx prettier --check .",
    "lint-check": "eslint --quiet .",
    "lint": "eslint --quiet . --fix",
    "ready": "npm run pretty && npm run lint && npm run build",
    "check": "npm run pretty-check && npm run lint-check",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase reset",
    "supabase:migrate:up": "supabase migration up",
    "supabase:create:migration": "supabase db diff -f",
    "supabase:db:reset": "supabase db reset",
    "supabase:login": "supabase login",
    "supabase:link": "supabase link",
    "supabase:db:prod:push": "supabase db push"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/node": "^22.13.10",
    "dotenv": "^16.4.7",
    "wrangler": "^3.111.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "engine": "workspace:*",
    "hono": "^4.7.2",
    "openai": "^4.86.2",
    "@supabase/supabase-js": "^2.49.1"
  }
}
