{
  "name": "hissab-api",
  "account_id": "a0609a9b2f23cde30f9f3a87339196b8",
  "compatibility_flags": [],
  "workers_dev": true,
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "build": {
    "command": "pnpm build",
    "upload": {
      "format": "modules",
      "rules": [
        {
          "type": "ESModule",
          "include": ["**/*.ts"],
          "esbuild": {
            "external": [
              "@polar-sh/sdk/src/models/components/webhookorderpaidpayload"
            ]
          }
        }
      ]
    }
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_RATE_LIMITER",
        "class_name": "UserRateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1", // Should be unique for each entry
      "new_sqlite_classes": ["UserRateLimiter"] // Array of new classes
    }
  ],
  "d1_databases": [
    {
      "binding": "LOGS_DB", // available in your Worker on env.DB
      "database_name": "dev-logs",
      "database_id": "b09e290c-7458-4f9c-9c24-5c2bc4f53a50",
      "migrations_dir": "migrations/logs"
    },
    {
      "binding": "USER_DB",
      "database_name": "hsb-dev-user",
      "database_id": "eec9843e-0bab-483b-8d04-2bccf0541a19",
      "migrations_dir": "migrations/user"
    }
  ],
  "env": {
    "prod": {
      "workers_dev": false,
      "route": {
        "pattern": "api.hissab.io",
        "custom_domain": true
      },
      "d1_databases": [
        {
          "binding": "LOGS_DB", // available in your Worker on env.DB
          "database_name": "prod-logs",
          "database_id": "3a00b3d0-98ad-4c7c-abbb-5aebcdf46104",
          "migrations_dir": "migrations/logs"
        },
        {
          "binding": "USER_DB",
          "database_name": "hsb-prod-user",
          "database_id": "0bf45c8d-eec1-42de-a1a4-1b23ac79714a",
          "migrations_dir": "migrations/user"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "USER_RATE_LIMITER",
            "class_name": "UserRateLimiter"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1", // Should be unique for each entry
          "new_sqlite_classes": ["UserRateLimiter"] // Array of new classes
        }
      ]
    },
    "dev": {
      "workers_dev": true,
      "route": {
        "pattern": "dev.api.hissab.io",
        "custom_domain": true
      },
      "d1_databases": [
        {
          "binding": "LOGS_DB", // available in your Worker on env.DB
          "database_name": "dev-logs",
          "database_id": "b09e290c-7458-4f9c-9c24-5c2bc4f53a50",
          "migrations_dir": "migrations/logs"
        },
        {
          "binding": "USER_DB",
          "database_name": "hsb-dev-user",
          "database_id": "eec9843e-0bab-483b-8d04-2bccf0541a19",
          "migrations_dir": "migrations/user"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "USER_RATE_LIMITER",
            "class_name": "UserRateLimiter"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1", // Should be unique for each entry
          "new_sqlite_classes": ["UserRateLimiter"] // Array of new classes
        }
      ]
    }
  }
}
