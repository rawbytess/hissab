{
  "name": "@rawbytes/hissab-app",
  "private": true,
  "version": "1.2.0",
  "description": "Hissab web client (PWA + Chrome extension) — the natural-language calculator UI",
  "type": "module",
  "author": "Mufaddal Makati <mufaddal@rawbytes.com> (https://hissab.io)",
  "license": "MIT",
  "homepage": "https://hissab.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rawbytess/hissab.git",
    "directory": "app"
  },
  "scripts": {
    "update": "pnpm update -i --latest",
    "dev": "vite --config vite.config.pwa.ts",
    "build": "pnpm build:pwa",
    "build:pwa": "tsc -b && vite build --config vite.config.pwa.ts && pnpm run generate:docs-crawl",
    "build:crx": "VITE_CHROME=true tsc -b && VITE_CHROME=true vite build --config vite.config.crx.ts",
    "generate:docs-crawl": "node scripts/generate-docs-crawl-pages.mjs",
    "build:zip": "npm-build-zip --source=dist/ --name=chrome",
    "chrome": "VITE_CHROME=true pnpm build:crx && pnpm build:zip",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.98.0",
    "@base-ui/react": "1.5.0",
    "@codemirror/autocomplete": "6.20.2",
    "@codemirror/commands": "6.10.3",
    "@codemirror/language": "6.12.3",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.0",
    "@docsearch/css": "^4.6.3",
    "@docsearch/react": "^4.6.3",
    "@google/genai": "2.6.0",
    "@lezer/highlight": "1.2.3",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tooltip": "1.2.8",
    "@rawbytes/hissab": "workspace:*",
    "function-plot": "1.25.4",
    "idb": "8.0.3",
    "idb-keyval": "6.2.4",
    "jotai": "2.20.0",
    "katex": "0.17.0",
    "lodash-es": "4.18.1",
    "lru-cache": "11.5.1",
    "lucide-react": "1.16.0",
    "next-themes": "0.4.6",
    "nuqs": "2.8.9",
    "openai": "6.39.0",
    "react-dropzone": "15.0.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tailwindcss-animate": "1.0.7",
    "vaul": "1.1.2",
    "wouter": "3.10.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.4.0",
    "@tailwindcss/vite": "4.3.0",
    "@types/lodash-es": "4.17.12",
    "@vitejs/plugin-react-swc": "4.3.1",
    "chrome-webstore-upload-cli": "4.0.0",
    "globals": "17.6.0",
    "npm-build-zip": "1.0.4",
    "vite": "8.0.13",
    "vite-plugin-pwa": "1.3.0"
  }
}
