{
  "name": "app",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "update": "pnpm update -i --latest",
    "dev": "vite --config vite.config.pwa.ts",
    "build:pwa": "tsc -b && vite build --config vite.config.pwa.ts",
    "build:crx": "VITE_CHROME=true tsc -b && VITE_CHROME=true vite build --config vite.config.crx.ts",
    "build:zip": "npm-build-zip --source=dist/ --name=chrome",
    "chrome": "VITE_CHROME=true pnpm build:crx && pnpm build:zip",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@uidotdev/usehooks": "^2.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "editor": "workspace:*",
    "engine": "workspace:*",
    "idb": "^8.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^1.0.14",
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "npm-build-zip": "^1.0.4",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1"
  }
}
