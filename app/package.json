{
  "name": "app",
  "private": true,
  "version": "3.2.0",
  "type": "module",
  "scripts": {
    "update": "pnpm update -i --latest",
    "dev": "vite --config vite.config.pwa.ts",
    "build": "pnpm build:pwa",
    "build:pwa": "tsc -b && vite build --config vite.config.pwa.ts",
    "build:crx": "VITE_CHROME=true tsc -b && VITE_CHROME=true vite build --config vite.config.crx.ts",
    "build:zip": "npm-build-zip --source=dist/ --name=chrome",
    "chrome": "VITE_CHROME=true pnpm build:crx && pnpm build:zip",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "6.36.8",
    "@lezer/highlight": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.7",
    "ldrs": "^1.1.7",
    "lodash": "^4.17.21",
    "lru-cache": "^11.1.0",
    "lucide-react": "^0.511.0",
    "nuqs": "^2.4.3",
    "react-dropzone": "^14.3.8",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^1.0.14",
    "@types/lodash": "^4.17.17",
    "@vitejs/plugin-react-swc": "^3.10.0",
    "autoprefixer": "^10.4.21",
    "chrome-webstore-upload-cli": "^3.3.2",
    "globals": "^16.2.0",
    "npm-build-zip": "^1.0.4",
    "vite": "^6.3.5",
    "vite-plugin-node-polyfills": "^0.23.0",
    "vite-plugin-pwa": "^1.0.0"
  }
}
