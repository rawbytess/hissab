{
  "name": "app",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "update": "pnpm update -i --latest",
    "dev": "vite --config vite.config.pwa.ts",
    "build:pwa": "tsc -b && vite build --config vite.config.pwa.ts",
    "build:crx": "VITE_CHROME=true tsc -b && VITE_CHROME=true vite build --config vite.config.crx.ts",
    "build:zip": "npm-build-zip --source=dist/ --name=chrome",
    "chrome": "VITE_CHROME=true pnpm build:crx && pnpm build:zip",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@heroui/card": "^2.2.15",
    "@heroui/react": "^2.7.5",
    "@heroui/spinner": "^2.2.13",
    "@iconify/react": "^5.2.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.68.0",
    "@uidotdev/usehooks": "^2.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "editor": "workspace:*",
    "embla-carousel-react": "^8.5.2",
    "engine": "workspace:*",
    "idb": "^8.0.0",
    "ldrs": "^1.1.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^1.0.14",
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "npm-build-zip": "^1.0.4",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1"
  }
}
