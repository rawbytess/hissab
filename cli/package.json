{
  "name": "@rawbytes/hissab-cli",
  "version": "1.0.2",
  "description": "Hissab CLI — natural-language calculator in your terminal, powered by the Hissab engine",
  "type": "module",
  "bin": {
    "hissab": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepack": "tsup",
    "build:bin": "pnpm build:bin:darwin-arm64 && pnpm build:bin:darwin-x64 && pnpm build:bin:linux-x64 && pnpm build:bin:linux-arm64 && pnpm build:bin:win-x64",
    "build:bin:darwin-arm64": "bun build --compile --target=bun-darwin-arm64 src/index.ts --outfile bin/hissab-darwin-arm64",
    "build:bin:darwin-x64": "bun build --compile --target=bun-darwin-x64 src/index.ts --outfile bin/hissab-darwin-x64",
    "build:bin:linux-x64": "bun build --compile --target=bun-linux-x64 src/index.ts --outfile bin/hissab-linux-x64",
    "build:bin:linux-arm64": "bun build --compile --target=bun-linux-arm64 src/index.ts --outfile bin/hissab-linux-arm64",
    "build:bin:win-x64": "bun build --compile --target=bun-windows-x64 src/index.ts --outfile bin/hissab-win-x64.exe"
  },
  "keywords": [
    "calculator",
    "cli",
    "units",
    "unit-conversion",
    "natural-language",
    "math",
    "repl",
    "hissab"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "Mufaddal Makati <mufaddal@rawbytes.com> (https://hissab.io)",
  "license": "MIT",
  "homepage": "https://hissab.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rawbytess/hissab.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/rawbytess/hissab/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@rawbytes/hissab": "workspace:*",
    "@types/bun": "1.3.14",
    "commander": "15.0.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  }
}
