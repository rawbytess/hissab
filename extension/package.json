{
  "name": "@rawbytes/hissab-extension",
  "private": true,
  "version": "4.0.0",
  "description": "Hissab Chrome extension - single-editor natural-language calculator popup",
  "type": "module",
  "author": "Mufaddal Makati <mufaddal@rawbytes.com> (https://hissab.io)",
  "license": "MIT",
  "homepage": "https://hissab.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rawbytess/hissab.git",
    "directory": "extension"
  },
  "scripts": {
    "dev": "vite",
    "watch": "vite build --watch",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "zip": "npm-build-zip --source=dist/ --name=chrome",
    "package": "pnpm build && pnpm zip"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@rawbytes/hissab": "workspace:*",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@vitejs/plugin-react-swc": "4.3.3",
    "chrome-webstore-upload-cli": "4.0.0",
    "npm-build-zip": "1.0.4",
    "vite": "8.3.0"
  }
}
